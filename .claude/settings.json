{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm add *)",
      "Bash(npm update *)",
      "Bash(npm --prefix * install *)",
      "Bash(npx *)",
      "Bash(go get *)",
      "Bash(go install *)",
      "Bash(go mod tidy *)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(npm add *)",
      "PowerShell(npm update *)",
      "PowerShell(npm --prefix * install *)",
      "PowerShell(npx *)",
      "PowerShell(go get *)",
      "PowerShell(go install *)",
      "PowerShell(go mod tidy *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-stop.sh\"",
            "timeout": 120,
            "statusMessage": "Running checks"
          }
        ]
      }
    ]
  }
}
